# PrintStation backend
PRINTSTATION_API_URL=http://localhost:5000
PRINTSTATION_WS_URL=ws://localhost:5000/ws/agent

# Optional for automated deployment. First-run desktop pairing can configure these automatically.
AGENT_ID=
AGENT_SECRET=
AGENT_NAME=

# Local Agent runtime
AGENT_UI_PORT=47821
AGENT_DATA_DIR=./data
HEARTBEAT_INTERVAL_MS=15000
JOB_POLL_INTERVAL_MS=10000
DOWNLOAD_DIR=./data/jobs
