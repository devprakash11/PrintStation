{
  "name": "printstation-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "PrintStation monorepo with React frontend, Node.js backend, and Windows print agent",
  "workspaces": [
    "frontend",
    "backend",
    "agent"
  ],
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:agent": "npm run dev --workspace=agent",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "start": "npm run start --workspace=backend",
    "start:agent": "npm run start --workspace=agent",
    "seed:admin": "npm run seed:admin --workspace=backend"
  },
  "engines": {
    "node": ">=18"
  }
}
